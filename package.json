{
  "name": "venera-configs",
  "version": "1.0.0",
  "description": "Configuration files for venera",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build:plugin": "node scripts/build-source.js",
    "build:ehentai": "npm run build:plugin -- ehentai",
    "build:all": "npm run build:plugin -- all",
    "discover:plugins": "node scripts/build/discover-plugins.js",
    "validate:plugins": "node scripts/build/validate-plugin-config.js",
    "write:build-manifest": "node scripts/build/write-build-manifest.js",
    "generate": "node scripts/build/generate.js",
    "check-generated": "node scripts/build/check-generated.js",
    "sync-manifest": "node scripts/sync-index.js",
    "check:manifest": "node scripts/sync-index.js --check",
    "sync-index": "npm run sync-manifest",
    "check:index": "npm run check:manifest",
    "validate:release-authority": "node scripts/build/validate-release-authority.js",
    "test": "node --test",
    "test:runtime": "node scripts/runtime/run-runtime-tests.js",
    "audit:unsafe-runtime-code": "node scripts/audit/unsafe-runtime-code.js",
    "pipeline:validate": "npm run validate:release-authority && npm run validate:plugins",
    "prepipeline:build": "npm run pipeline:validate",
    "pipeline:build": "npm run generate",
    "postpipeline:build": "npm run check-generated",
    "pipeline:test": "npm run test",
    "postpipeline:test": "npm run test:runtime && npm run audit:unsafe-runtime-code",
    "prepipeline:verify": "npm run pipeline:build",
    "pipeline:verify": "npm run check:index",
    "postpipeline:verify": "npm run pipeline:test",
    "pipeline:ci": "npm run pipeline:verify"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/preset-env": "^7.23.0",
    "esbuild": "^0.25.4",
    "terser": "^5.29.0",
    "zod": "^4.1.5"
  }
}
